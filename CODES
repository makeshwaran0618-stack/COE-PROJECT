        .ring-caption {
            font-size: 11.5px;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: var(--slate-400);
        }

        .stat-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px;
        }

        @media (max-width: 480px) {
            .stat-row {
                grid-template-columns: 1fr;
            }
        }

        .stat-box {
            background: var(--slate-050);
            border-radius: 14px;
            padding: 16px 18px;
        }

        .stat-box .stat-title {
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            color: var(--slate-400);
            margin: 0 0 6px;
        }

        .volume {
            font-family: 'Manrope', sans-serif;
            font-size: 24px;
            font-weight: 800;
            color: var(--slate-800);
        }

        .status {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-family: 'Manrope', sans-serif;
            font-size: 20px;
            font-weight: 800;
            padding: 4px 2px;
            border-radius: 8px;
            transition: color 0.3s ease;
        }

        .status::before {
            content: "";
            width: 9px;
            height: 9px;
            border-radius: 50%;
            background: currentColor;
            flex-shrink: 0;
        }

        .footer-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 10px;
            padding-top: 6px;
            border-top: 1px solid var(--slate-100);
        }

        .last-updated {
            font-size: 13px;
            color: var(--slate-600);
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .last-updated .dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: var(--teal-500);
            animation: pulse 1.6s infinite;
        }

        .error {
            width: 100%;
            text-align: center;
            color: var(--empty-fg);
            background: var(--empty-bg);
            border-radius: 10px;
            padding: 10px;
            font-size: 13.5px;
            font-weight: 600;
            display: none;
        }

        .error:not(:empty) {
            display: block;
        }

    </style>

</head>

<body>

    <header class="topbar">
        <div class="brand">
            <div class="brand-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
                    <path d="M12 2c3 3.5 6 7.5 6 11a6 6 0 1 1-12 0c0-3.5 3-7.5 6-11z" stroke="#7fe6dc" stroke-width="1.8" stroke-linejoin="round"/>
                </svg>
            </div>
            <div class="brand-text">
                <h1>IV Monitoring System</h1>
                <p>Real-Time Fluid Level Tracking</p>
            </div>
        </div>

        <div class="status-cluster">
            <span class="pill" id="connectionPill">
                <span class="live-dot" id="connectionDot"></span>
                <span id="connectionText">Connecting…</span>
            </span>
            <span class="pill live">
                <span class="live-dot"></span>
                LIVE
            </span>
        </div>
    </header>

    <div class="wrap">
        <div class="grid">

            <!-- Left column: Patient + Nurse -->
            <div style="display:flex; flex-direction:column; gap:22px;">

                <!-- Patient Information -->
                <div class="card patient-card">
                    <div>
                        <p class="card-label">Patient Information</p>

                        <div class="info-row">
                            <div class="info-icon">
                                <svg width="19" height="19" viewBox="0 0 24 24" fill="none">
                                    <circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.8"/>
                                    <path d="M4 20c0-4.4 3.6-7 8-7s8 2.6 8 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                                </svg>
                            </div>
                            <div class="info-text">
                                <div class="info-title">Patient</div>
                                <div class="info-value" id="patient">Test Patient</div>
                            </div>
                        </div>
                    </div>

                    <div class="divider"></div>

                    <div class="info-row">
                        <div class="info-icon">
                            <svg width="19" height="19" viewBox="0 0 24 24" fill="none">
                                <path d="M3 19v-9a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M3 19h18M6 12V7a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                            </svg>
                        </div>
                        <div class="info-text">
                            <div class="info-title">Bed Number</div>
                            <div class="info-value" id="bed">Loading...</div>
                        </div>
                    </div>

                    <div class="divider"></div>

                    <p class="device-note">Data streamed from the bedside ESP32 load-cell sensor via the hospital monitoring API, refreshed automatically every 2 seconds.</p>
                </div>

                <!-- On-Duty Nurse (static contact card, not fetched from API) -->
                <div class="card nurse-card">
                    <div>
                        <p class="card-label" style="margin-bottom:0;">Care Team</p>
                        <span class="nurse-badge"><span class="dot-sm"></span>On Duty</span>

                        <div class="info-row">
                            <div class="info-icon">
                                <svg width="19" height="19" viewBox="0 0 24 24" fill="none">
                                    <path d="M12 21s-7-4.5-9.5-9A5.5 5.5 0 0 1 12 6a5.5 5.5 0 0 1 9.5 6c-2.5 4.5-9.5 9-9.5 9z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
                                </svg>
                            </div>
                            <div class="info-text">
                                <div class="info-title">Assigned Nurse</div>
                                <div class="info-value" id="nurse">Test Nurse</div>
                            </div>
                        </div>
                    </div>

                    <div class="divider"></div>

                    <div class="info-row">
                        <div class="info-icon">
                            <svg width="19" height="19" viewBox="0 0 24 24" fill="none">
                                <path d="M6.6 10.8c1.4 2.8 3.8 5.2 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.2c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1L6.6 10.8z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
                            </svg>
                        </div>
                        <div class="info-text">
                            <div class="info-title">Contact Number</div>
                            <a class="phone-link info-value" id="nursePhone" href="tel:+917305444010">+91 73054 44010</a>
                        </div>
                    </div>

                    <div class="divider"></div>

                    <button class="call-btn" id="callNurseBtn">
                        <span class="spinner"></span>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                            <path d="M6.6 10.8c1.4 2.8 3.8 5.2 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.2c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1L6.6 10.8z" fill="currentColor"/>
                        </svg>
                        <span id="callBtnLabel">Call Nurse</span>
                    </button>

                    <div class="call-status" id="callStatus"></div>

                    <p class="device-note">Mock contact details for hackathon demo purposes. Not sourced from the live API. "Call Nurse" places a real VoIP call via Twilio.</p>
                </div>

            </div>

            <!-- Main Monitor -->
            <div class="card monitor-card">
                <div class="monitor-top">
                    <p class="card-label" style="margin:0;">IV Monitoring</p>
                </div>

                <div class="ring-section">
                    <div class="ring-wrap">
                        <svg viewBox="0 0 220 220">
                            <circle class="ring-track" cx="110" cy="110" r="90"></circle>
                            <circle class="ring-value" id="ringValue" cx="110" cy="110" r="90"
                                stroke-dasharray="565.48" stroke-dashoffset="565.48"></circle>
                        </svg>
                        <div class="ring-center">
                            <div class="percentage" id="percentage">0%</div>
                            <div class="ring-caption">IV Remaining</div>
                        </div>
                    </div>
                </div>

                <div class="stat-row">
                    <div class="stat-box">
                        <p class="stat-title">IV Volume</p>
                        <div class="volume" id="volume">0.00 mL</div>
                    </div>
                    <div class="stat-box">
                        <p class="stat-title">Status</p>
                        <div class="status" id="status">LOADING...</div>
                    </div>
                </div>

                <div class="alarm-banner" id="alarmBanner">
                    <div class="alarm-msg">
                        <span id="alarmIcon">⚠️</span>
                        <span id="alarmText">Fluid level low</span>
                    </div>
                    <button class="ack-btn" id="ackBtn">Acknowledged</button>
                </div>

                <div class="footer-row">
                    <div class="last-updated">
                        <span class="dot"></span>
                        <span>Last Updated: <span id="lastUpdated">Waiting...</span></span>
                    </div>
                </div>

                <div class="error" id="error"></div>
            </div>

        </div>
    </div>

    <script>

        // Circumference of the progress ring (r = 90)
        const RING_CIRCUMFERENCE = 2 * Math.PI * 90;

        /* =========================================================
           Alarm / Buzzer System
           - Warning zone  : 10% < percentage <= 20%  -> single buzz
           - Critical zone : 0%  < percentage < 10%   -> continuous beep
           - percentage === 0 (or missing/empty)      -> no buzzer at all
           - "Acknowledged" button silences the sound for the
             current critical episode; a fresh drop back into the
             critical zone after recovering will alarm again.
           ========================================================= */

        let audioCtx = null;
        let beepIntervalId = null;
        let currentAlarmLevel = "none";   // "none" | "warning" | "critical"
        let warningPlayedForThisEpisode = false;
        let criticalAcknowledged = false;

        function getAudioContext() {
            if (!audioCtx) {
                audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            }
            if (audioCtx.state === "suspended") {
                audioCtx.resume();
            }
            return audioCtx;
        }

        // Unlock audio on first user interaction (browser autoplay policy)
        function unlockAudioOnce() {
            getAudioContext();
            document.removeEventListener("click", unlockAudioOnce);
            document.removeEventListener("keydown", unlockAudioOnce);
        }
        document.addEventListener("click", unlockAudioOnce);
        document.addEventListener("keydown", unlockAudioOnce);

        function playTone(durationMs, frequency) {
            try {
                const ctx = getAudioContext();
                const oscillator = ctx.createOscillator();
                const gain = ctx.createGain();

                oscillator.type = "square";
                oscillator.frequency.value = frequency || 880;

                gain.gain.setValueAtTime(0.0001, ctx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.35, ctx.currentTime + 0.02);
                gain.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + durationMs / 1000);

                oscillator.connect(gain);
                gain.connect(ctx.destination);

                oscillator.start();
                oscillator.stop(ctx.currentTime + durationMs / 1000 + 0.02);
            } catch (e) {
                console.warn("Unable to play alarm tone:", e);
            }
        }

        function playSingleBuzz() {
            playTone(350, 660);
        }

        function startContinuousBeep() {
            if (beepIntervalId) return;
            playTone(300, 950);
            beepIntervalId = setInterval(() => playTone(300, 950), 700);
        }

        function stopContinuousBeep() {
            if (beepIntervalId) {
                clearInterval(beepIntervalId);
                beepIntervalId = null;
            }
        }

        function showAlarmBanner(level) {
            const banner = document.getElementById("alarmBanner");
            const icon = document.getElementById("alarmIcon");
            const text = document.getElementById("alarmText");
            const ackBtn = document.getElementById("ackBtn");

            banner.classList.remove("warning", "critical");

            if (level === "warning") {
                banner.classList.add("show", "warning");
                icon.innerText = "🔔";
                text.innerText = "Fluid level at 20% — please check the IV bag soon.";
                ackBtn.style.display = "none";
            } else if (level === "critical") {
                banner.classList.add("show", "critical");
                icon.innerText = "🚨";
                text.innerText = criticalAcknowledged
                    ? "Critical: fluid below 10% — alarm acknowledged."
                    : "Critical: fluid below 10% — immediate attention required!";
                ackBtn.style.display = "inline-block";
            } else {
                banner.classList.remove("show");
            }
        }

        function updateAlarm(percentage) {

            // Buzzer must never trigger at exactly 0% (empty / no reading)
            if (!percentage || percentage <= 0) {
                stopContinuousBeep();
                showAlarmBanner("none");
                currentAlarmLevel = "none";
                warningPlayedForThisEpisode = false;
                criticalAcknowledged = false;
                return;
            }

            if (percentage < 10) {

                // Entering critical zone fresh (e.g. came from warning/normal)
                if (currentAlarmLevel !== "critical") {
                    criticalAcknowledged = false;
                }

                currentAlarmLevel = "critical";
                showAlarmBanner("critical");

                if (!criticalAcknowledged) {
                    startContinuousBeep();
                } else {
                    stopContinuousBeep();
                }

            } else if (percentage <= 20) {

                stopContinuousBeep();
                currentAlarmLevel = "warning";
                showAlarmBanner("warning");

                if (!warningPlayedForThisEpisode) {
                    playSingleBuzz();
                    warningPlayedForThisEpisode = true;
                }

            } else {

                // Back above 20% — reset everything for the next episode
                stopContinuousBeep();
                showAlarmBanner("none");
                currentAlarmLevel = "none";
                warningPlayedForThisEpisode = false;
                criticalAcknowledged = false;
            }
        }

        document.getElementById("ackBtn").addEventListener("click", function () {
            criticalAcknowledged = true;
            stopContinuousBeep();
            if (currentAlarmLevel === "critical") {
                showAlarmBanner("critical");
            }
        });

        /* =========================================================
           Call Nurse (VoIP via Twilio)
           Hits api/call_nurse.php on the backend, which places a
           real outbound call through the Twilio Voice API.
           ========================================================= */

        document.getElementById("callNurseBtn").addEventListener("click", function () {

            const btn = document.getElementById("callNurseBtn");
            const label = document.getElementById("callBtnLabel");
            const statusEl = document.getElementById("callStatus");

            btn.disabled = true;
            btn.classList.add("calling");
            label.innerText = "Calling…";
            statusEl.innerText = "";
            statusEl.className = "call-status";

            fetch("api/call_nurse.php", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                    bed: document.getElementById("bed").innerText,
                    status: document.getElementById("status").innerText,
                    percentage: document.getElementById("percentage").innerText
                })
            })
                .then(response => response.json())
                .then(result => {

                    btn.classList.remove("calling");
                    btn.disabled = false;
                    label.innerText = "Call Nurse";

                    if (result.success) {
                        statusEl.innerText = "Call placed successfully.";
                        statusEl.className = "call-status success";
                    } else {
                        statusEl.innerText = result.message || "Call failed. Please try again.";
                        statusEl.className = "call-status error";
                    }
                })
                .catch(error => {

                    console.error("Error calling nurse:", error);

                    btn.classList.remove("calling");
                    btn.disabled = false;
                    label.innerText = "Call Nurse";

                    statusEl.innerText = "Unable to reach the call server.";
                    statusEl.className = "call-status error";
                });
        });

        function setConnectionState(connected) {

            const pill = document.getElementById("connectionPill");
            const text = document.getElementById("connectionText");

            if (connected) {
                pill.classList.add("live");
                text.innerText = "Connected";
            } else {
                pill.classList.remove("live");
                text.innerText = "Disconnected";
            }
        }

        function updateRing(percentage, color) {

            const ring = document.getElementById("ringValue");

            let clamped = Math.max(0, Math.min(100, percentage));
            let offset = RING_CIRCUMFERENCE - (clamped / 100) * RING_CIRCUMFERENCE;

            ring.style.strokeDashoffset = offset;
            ring.style.stroke = color;
        }

        function loadIVData() {

            fetch("api/get_iv_data.php")

                .then(response => {

                    if (!response.ok) {
                        throw new Error("Network response was not OK");
                    }

                    return response.json();

                })

                .then(data => {

                    console.log("Received data:", data);

                    let ivData = data.data ? data.data : data;


                    // Bed Number
                    document.getElementById("bed").innerText =
                        ivData.bed_number || "B-101";


                    // Fluid Percentage
                    let percentage =
                        parseFloat(ivData.fluid_percentage) || 0;

                    document.getElementById("percentage").innerText =
                        percentage.toFixed(1) + "%";


                    // Fluid Volume
                    let volume =
                        parseFloat(ivData.fluid_volume_ml) || 0;

                    document.getElementById("volume").innerText =
                        volume.toFixed(1) + " mL";


                    // Status
                    let status =
                        ivData.status || "EMPTY";

                    status = status.toUpperCase();

                    let statusElement =
                        document.getElementById("status");

                    statusElement.innerText = status;


                    // Change status box color + ring color to match
                    let ringColor = "#0f9d92";

                    if (status === "FULL") {

                        statusElement.style.color = "var(--full-fg)";
                        ringColor = getComputedStyle(document.documentElement).getPropertyValue('--full-fg').trim();

                    }

                    else if (status === "MEDIUM") {

                        statusElement.style.color = "var(--medium-fg)";
                        ringColor = getComputedStyle(document.documentElement).getPropertyValue('--medium-fg').trim();

                    }

                    else if (status === "LOW") {

                        statusElement.style.color = "var(--low-fg)";
                        ringColor = getComputedStyle(document.documentElement).getPropertyValue('--low-fg').trim();

                    }

                    else if (status === "EMPTY") {

                        statusElement.style.color = "var(--empty-fg)";
                        ringColor = getComputedStyle(document.documentElement).getPropertyValue('--empty-fg').trim();

                    }

                    else {

                        statusElement.style.color = "var(--idle-fg)";
                        ringColor = getComputedStyle(document.documentElement).getPropertyValue('--idle-fg').trim();

                    }

                    updateRing(percentage, ringColor);


                    // Buzzer / alarm logic based on live fluid percentage
                    updateAlarm(percentage);


                    // Last Updated
                    document.getElementById("lastUpdated").innerText =
                        (ivData.last_updated || "Unknown");


                    // Remove error message
                    document.getElementById("error").innerText = "";

                    setConnectionState(true);

                })

                .catch(error => {

                    console.error("Error loading IV data:", error);

                    document.getElementById("error").innerText =
                        "Unable to connect to server";

                    setConnectionState(false);
                    stopContinuousBeep();

                });

        }


        // Load data immediately when the page opens
        loadIVData();


        // Automatically refresh data every 2 seconds
        setInterval(loadIVData, 300);

    </script>

</body>

