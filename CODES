CALIBRATION CODE
------------------

  #include "HX711.h"

#define DOUT_PIN 4
#define SCK_PIN 5

HX711 scale;

float calibration_factor = 465.5;

// CHANGE THESE VALUES
float empty_bottle_weight = 30.0;  // grams
float full_fluid_weight = 500.0;   // grams

void setup() {
  Serial.begin(115200);
  delay(2000);

  scale.begin(DOUT_PIN, SCK_PIN);

  scale.set_scale(calibration_factor);

  Serial.println("Remove all weight...");
  delay(5000);

  scale.tare(50);

  Serial.println("TARE COMPLETE!");
}

void loop() {

  // Measure total weight
  float total_weight = scale.get_units(20);

  // Remove small noise
  if (abs(total_weight) < 1.0) {
    total_weight = 0;
  }

  // Calculate fluid weight
  float fluid_weight = total_weight - empty_bottle_weight;

  // Prevent negative fluid weight
  if (fluid_weight < 0) {
    fluid_weight = 0;
  }

  // For water-like fluid: 1 g ≈ 1 mL
  float fluid_ml = fluid_weight;

  // Calculate fluid percentage
  float fluid_percentage =
    (fluid_weight / full_fluid_weight) * 100.0;

  // Limit percentage between 0 and 100
  if (fluid_percentage < 0) {
    fluid_percentage = 0;
  }

  if (fluid_percentage > 100) {
    fluid_percentage = 100;
  }

  Serial.println("-----------------------------");



  Serial.print("Fluid Volume: ");
  Serial.print(fluid_ml, 2);
  Serial.println(" mL");

  Serial.print("Fluid Percentage: ");
  Serial.print(fluid_percentage, 2);
  Serial.println(" %");

  delay(1000);
}


