  <?php
/**
 * call_nurse.php
 * ---------------------------------------------------------------
 * Places a real outbound VoIP phone call to the on-duty nurse
 * using the Twilio Voice REST API, with an automated spoken
 * alert describing the current IV status.
 *
 * This file is intentionally dependency-free (plain cURL) so it
 * can drop straight into a hackathon PHP stack without Composer.
 *
 * SETUP (required before this will work):
 *   1. Create a free Twilio account: https://www.twilio.com/try-twilio
 *   2. Buy/claim a Twilio phone number (trial accounts get one free).
 *   3. Fill in the four constants below with your own values.
 *   4. On a Twilio TRIAL account, you can only call phone numbers
 *      that have been verified in the Twilio console
 *      (Console -> Phone Numbers -> Verified Caller IDs).
 * ---------------------------------------------------------------
 */

header('Content-Type: application/json');

// ======================= CONFIGURE ME =======================
// Never expose these values in frontend/client-side code.
const TWILIO_ACCOUNT_SID = 'ACb4d07da050b2e2132d1ec9beca295955';   // from Twilio Console
const TWILIO_AUTH_TOKEN  = '034fda516bdd9a78f319b8ae70ecddc5';                 // from Twilio Console
const TWILIO_FROM_NUMBER = '+19383884193';                         // your Twilio number
const NURSE_PHONE_NUMBER = '+917305444010';                         // nurse's real phone number
// ===============================================================

// Read the alert context sent from the dashboard (optional, purely
// used to personalize the spoken message — does not affect any
// existing IV data logic).
$input = json_decode(file_get_contents('php://input'), true) ?? [];

$bed        = htmlspecialchars($input['bed'] ?? 'B-101', ENT_QUOTES);
$status     = htmlspecialchars($input['status'] ?? 'UNKNOWN', ENT_QUOTES);
$percentage = htmlspecialchars($input['percentage'] ?? '', ENT_QUOTES);

// Build the spoken message read out by Twilio's text-to-speech
$message = "Attention. This is an automated call from the I V monitoring system. "
         . "Bed {$bed} requires attention. "
         . "Current fluid status is {$status}. ";

if ($percentage !== '') {
    $message .= "Fluid level is at {$percentage}. ";
}

$message .= "Please respond as soon as possible.";

// Twilio expects TwiML (XML) describing what the call should do
$twiml = '<?xml version="1.0" encoding="UTF-8"?>'
       . '<Response><Say voice="alice">' . htmlspecialchars($message, ENT_XML1) . '</Say></Response>';

// Basic guard so we don't attempt a call with placeholder credentials
if (
    TWILIO_ACCOUNT_SID === 'ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx' ||
    TWILIO_AUTH_TOKEN === 'your_auth_token_here'
) {
    http_response_code(500);
    echo json_encode([
        'success' => false,
        'message' => 'Twilio credentials are not configured on the server yet.'
    ]);
    exit;
}

$url = "https://api.twilio.com/2010-04-01/Accounts/" . TWILIO_ACCOUNT_SID . "/Calls.json";

$postFields = http_build_query([
    'To'    => NURSE_PHONE_NUMBER,
    'From'  => TWILIO_FROM_NUMBER,
    'Twiml' => $twiml,
]);

$ch = curl_init($url);
curl_setopt_array($ch, [
    CURLOPT_POST            => true,
    CURLOPT_POSTFIELDS      => $postFields,
    CURLOPT_USERPWD         => TWILIO_ACCOUNT_SID . ':' . TWILIO_AUTH_TOKEN,
    CURLOPT_RETURNTRANSFER  => true,
    CURLOPT_TIMEOUT         => 15,
]);

$response  = curl_exec($ch);
$httpCode  = curl_getinfo($ch, CURLINFO_HTTP_CODE);
$curlError = curl_error($ch);
curl_close($ch);

if ($curlError) {
    http_response_code(500);
    echo json_encode([
        'success' => false,
        'message' => 'Connection to Twilio failed: ' . $curlError
    ]);
    exit;
}

$result = json_decode($response, true);

if ($httpCode >= 200 && $httpCode < 300) {
    echo json_encode([
        'success'  => true,
        'message'  => 'Call placed successfully.',
        'call_sid' => $result['sid'] ?? null,
        'status'   => $result['status'] ?? null,
    ]);
} else {
    http_response_code($httpCode ?: 500);
    echo json_encode([
        'success' => false,
        'message' => $result['message'] ?? 'Twilio rejected the call request.'
    ]);
}


