IV_UPDATE.PHP
  <?php

header("Content-Type: application/json");

require_once "../config.php";


// Receive JSON data from ESP32

$jsonData = file_get_contents(
    "php://input"
);

$data = json_decode(
    $jsonData,
    true
);


// Check received data

if (!$data) {

    echo json_encode([

        "success" => false,

        "message" => "Invalid JSON data"

    ]);

    exit;

}


// Get values from ESP32

$device_id = $data["device_id"];

$bed_number = $data["bed_number"];

$fluid_volume_ml =
    $data["fluid_volume_ml"];

$fluid_percentage =
    $data["fluid_percentage"];


// Determine IV status

if ($fluid_percentage > 60) {

    $status = "FULL";

}

else if ($fluid_percentage >= 20) {

    $status = "MEDIUM";

}

else if ($fluid_percentage > 0) {

    $status = "LOW";

}

else {

    $status = "EMPTY";

}


// Update existing IV device

$sql = "

UPDATE iv_devices

SET

bed_number = ?,

fluid_volume_ml = ?,

fluid_percentage = ?,

status = ?,

last_updated = NOW()

WHERE device_id = ?

";


$stmt = $conn->prepare($sql);


$stmt->bind_param(

    "sddss",

    $bed_number,

    $fluid_volume_ml,

    $fluid_percentage,

    $status,

    $device_id

);


if ($stmt->execute()) {

    echo json_encode([

        "success" => true,

        "message" =>
        "IV data updated successfully",

        "device_id" =>
        $device_id,

        "fluid_volume_ml" =>
        $fluid_volume_ml,

        "fluid_percentage" =>
        $fluid_percentage,

        "status" =>
        $status

    ]);

}

else {

    echo json_encode([

        "success" => false,

        "message" =>
        "Database update failed"

    ]);

}


$stmt->close();

$conn->close();

?>

